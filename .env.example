# Hilux Autonomous AI Workforce OS — Environment Configuration

# NVIDIA Nemotron LLM Provider API Key
NEMOTRON_API_KEY=nvapi-your-nvidia-nemotron-api-key-here
NVIDIA_API_KEY=nvapi-your-nvidia-nemotron-api-key-here

# Optional: Override Nemotron Model (Default: nvidia/llama-3.1-nemotron-70b-instruct)
NEMOTRON_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
# NEMOTRON_MODEL=nvidia/nemotron-4-340b-instruct

# Optional Base URL for NVIDIA NIM
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1

# Kafka / Redis Message Bus (Production)
KAFKA_BROKERS=localhost:9092
REDIS_URL=redis://localhost:6379

# Neo4j Knowledge Graph & Qdrant Vector Store (Production)
NEO4J_URI=bolt://localhost:7687
QDRANT_URL=http://localhost:6333
